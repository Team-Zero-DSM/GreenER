// DER físico da versão final. Fonte: database/schema.sql.
// PK = chave primária; FK = chave estrangeira; UK = unicidade individual.
// U1 = UNIQUE composto de coleta(servico_id, coletado_em).
// Cardinalidades incluem nulabilidade, PK/FK de painel e configuração única.
digraph GreenER {
graph [rankdir=LR, bgcolor="#f4f9f7", pad="0.45", nodesep="0.5", ranksep="1.35", splines=polyline, fontname="Arial", fontsize=26, labelloc=t, labeljust=l, ordering=out, outputorder=edgesfirst, concentrate=false, newrank=true];
node [shape=plain, fontname="Arial", fontsize=14];
edge [fontname="Arial", fontsize=11, color="#43736b", fontcolor="#214b43", penwidth=1.5, arrowsize=0.85, dir=both, labeldistance=3.2, labelangle=-30];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="30" COLOR="#103f35"><B>GreenER | DER da versão final</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PostgreSQL · 10 tabelas · 77 colunas · 9 chaves estrangeiras</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Fonte: database/schema.sql | PK: primária · FK: estrangeira · UK: única · U1: única composta</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">1: obrigatório · 0..1: opcional · 0..N: zero ou muitos | NULL: aceita valor nulo</FONT></TD></TR></TABLE>>;
subgraph cluster_acesso { label="Contas, painéis e configurações"; style="rounded"; color="#c9dbd2"; bgcolor="#edf5f0"; fontsize=19; fontcolor="#315a4c"; margin=25;
