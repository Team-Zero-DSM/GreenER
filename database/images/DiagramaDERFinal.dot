nsolas" POINT-SIZE="13">acesso_ativo</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12" COLOR="#4c6661">BOOLEAN</FONT></TD><TD PORT="acesso_ativo_right" BGCOLOR="#ffffff"><FONT POINT-SIZE="11" COLOR="#63756f">NOT NULL</FONT></TD></TR><TR><TD PORT="versao_sessao_left" ALIGN="LEFT" BGCOLOR="#f3f7f5"><FONT POINT-SIZE="12" COLOR="#165c45"><B> </B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#f3f7f5"><FONT FACE="Consolas" POINT-SIZE="13">versao_sessao</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#f3f7f5"><FONT POINT-SIZE="12" COLOR="#4c6661">INTEGER</FONT></TD><TD PORT="versao_sessao_right" BGCOLOR="#f3f7f5"><FONT POINT-SIZE="11" COLOR="#63756f">NOT NULL</FONT></TD></TR><TR><TD PORT="papel_left" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12" COLOR="#165c45"><B> </B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Consolas" POINT-SIZE="13">papel</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12" COLOR="#4c6661">TEXT</FONT></TD><TD PORT="papel_right" BGCOLOR="#ffffff"><FONT POINT-SIZE="11" COLOR="#63756f">NOT NULL</FONT></TD></TR><TR><TD PORT="criado_em_left" ALIGN="LEFT" BGCOLOR="#f3f7f5"><FONT POINT-SIZE="12" COLOR="#165c45"><B> </B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#f3f7f5"><FONT FACE="Consolas" POINT-SIZE="13">criado_em</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#f3f7f5"><FONT POINT-SIZE="12" COLOR="#4c6661">TIMESTAMPTZ</FONT></TD><TD PORT="criado_em_right" BGCOLOR="#f3f7f5"><FONT POINT-SIZE="11" COLOR="#63756f">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#e9f2ed"><FONT POINT-SIZE="11" COLOR="#365d50">email: UNIQUE + índice único em lower(email)</FONT></TD></TR></TABLE>>];
