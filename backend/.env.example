NODE_ENV=development
PORT=3000

DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_NAME=greener
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
# Em produção (Supabase), use a connection string no lugar das variáveis acima.
# DATABASE_URL=postgresql://postgres.<projeto>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
# DATABASE_SSL=true

JWT_SECRET=development_secret
CORS_ORIGIN=http://localhost:5173

METRICS_API_URL=https://metrics.unilaunch.org
COLLECTION_INTERVAL_SECONDS=30
CARBON_API_URL=https://carbon.unilaunch.org
